# 复制为 .env 并填写；生产值建议放进服务器 /opt/my-life/deploy/.env
# 密码哈希生成：npm run hash -- '你的强密码'
PASSWORD_HASH=
# token 签名密钥：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET=
PORT=8788
DATA_DIR=./data-dev
TOKEN_DAYS=30
# 可选：可信 Java AI 服务私网地址；密钥与 Java calendar/diary 服务一致，至少32字符。
# 不填写时 AI 功能关闭，普通录入、日记与同步不受影响。
AI_JAVA_URL=
AI_BRIDGE_SECRET=
